<Window x:Class="NetEaseNEXT.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:NetEaseNEXT.Models" xmlns:services="using:NetEaseNEXT.Services" Title="NetEaseNEXT">
 <ContentControl x:Name="FontHost" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid x:Name="Root" UseLayoutRounding="True">
  <Grid.Resources><DataTemplate x:Key="PlaylistChoiceTemplate" x:DataType="models:Playlist"><Grid ColumnSpacing="12" Padding="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border CornerRadius="5" Width="48" Height="48"><Image services:Artwork.Uri="{Binding Cover}" services:Artwork.Size="48" Stretch="UniformToFill"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></DataTemplate></Grid.Resources>
  <Grid.KeyboardAccelerators><KeyboardAccelerator Key="F11" Invoked="FullScreen_Key"/><KeyboardAccelerator Key="Escape" Invoked="Escape_Key"/><KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Key"/><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Key"/></Grid.KeyboardAccelerators>
  <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="SolidLayer" Grid.RowSpan="3" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False"/>
  <Grid ColumnSpacing="10" Padding="10,0,140,0"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="BackButton" Click="Back_Click" Width="40" Height="36" MinHeight="36" Background="Transparent" BorderThickness="0" AutomationProperties.Name="返回"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button><Grid x:Name="TitleBar" Grid.Column="1" Background="Transparent"><TextBlock Text="NetEaseNEXT" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Grid>
  <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="208" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Navigation_Changed" AlwaysShowHeader="False">
   <NavigationView.MenuItems><NavigationViewItem Content="发现" Tag="discover" Icon="Home" IsSelected="True"/><NavigationViewItem Content="歌手" Tag="artists" Icon="People"/><NavigationViewItem Content="歌单" Tag="library" Icon="Library"/><NavigationViewItem Content="电台" Tag="radio" Icon="Audio"/><NavigationViewItem Content="动态" Tag="events" Icon="Comment"/><NavigationViewItem Content="播放列表" Tag="queue" Icon="List"/></NavigationView.MenuItems>
   <NavigationView.PaneFooter><Button x:Name="AccountButton" Click="Account_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10" Margin="4,0,4,10"><StackPanel Orientation="Horizontal" Spacing="10"><PersonPicture x:Name="AccountAvatar" Width="34" Height="34"/><TextBlock x:Name="AccountName" Text="未登录" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="128"/></StackPanel></Button></NavigationView.PaneFooter>
   <Grid x:Name="ContentArea" Padding="24,8,24,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageTitle" Text="发现" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button x:Name="CreatePlaylistButton" Grid.Column="1" Content="创建歌单" Click="CreatePlaylist_Click" Visibility="Collapsed" Margin="0,0,12,0"/><AutoSuggestBox x:Name="SearchBox" Grid.Column="2" Width="280" PlaceholderText="搜索" QueryIcon="Find" QuerySubmitted="Search_Submitted" AutomationProperties.Name="搜索"/></Grid>
    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,12"/>
    <Grid x:Name="PageBody" Grid.Row="2">
     <Grid x:Name="BrowsePanel"><GridView x:Name="PlaylistGrid" ItemsSource="{x:Bind Playlists}" IsItemClickEnabled="True" ItemClick="Playlist_Click" SelectionMode="None" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="184" ItemHeight="236"/></ItemsPanelTemplate></GridView.ItemsPanel><GridView.ItemTemplate><DataTemplate x:DataType="models:Playlist"><StackPanel Width="164" Spacing="10" Margin="4,4,4,12"><Border CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Height="164"><Grid><FontIcon Glyph="&#xE8D6;" Opacity=".2"/><Image Stretch="UniformToFill" services:Artwork.Uri="{Binding Cover, Mode=OneTime}" services:Artwork.Size="164"/></Grid></Border><TextBlock Text="{Binding Name, Mode=OneTime}" TextWrapping="Wrap" MaxLines="2"/></StackPanel></DataTemplate></GridView.ItemTemplate></GridView></Grid>
     <Grid x:Name="CatalogPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><GridView x:Name="CatalogGrid" ItemsSource="{x:Bind Catalog}" IsItemClickEnabled="True" ItemClick="Catalog_Click" SelectionMode="None" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="184" ItemHeight="250"/></ItemsPanelTemplate></GridView.ItemsPanel><GridView.ItemTemplate><DataTemplate x:DataType="models:CatalogItem"><StackPanel Width="164" Spacing="8" Margin="4"><Border Height="164" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid><FontIcon Glyph="&#xE8D6;" Opacity=".2"/><Image Stretch="UniformToFill" services:Artwork.Uri="{Binding Cover, Mode=OneTime}" services:Artwork.Size="164"/></Grid></Border><TextBlock Text="{Binding Name, Mode=OneTime}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle, Mode=OneTime}" FontSize="12" Opacity=".6" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></GridView.ItemTemplate></GridView><Button x:Name="CatalogMore" Grid.Row="1" Content="加载更多" Click="LoadMore_Click" HorizontalAlignment="Center" Margin="0,8"/></Grid>
     <Grid x:Name="TracksPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="14" Margin="0,0,0,12"><Grid x:Name="PlaylistDetails" Visibility="Collapsed" ColumnSpacing="22" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="164" Height="164" CornerRadius="10" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Image x:Name="PlaylistDetailCover" services:Artwork.Size="192" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Spacing="8"><TextBlock x:Name="PlaylistDetailTitle" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/><TextBlock x:Name="PlaylistCreator" Opacity=".65"/><TextBlock x:Name="PlaylistTags" FontSize="12" Opacity=".65" TextWrapping="Wrap"/><TextBlock x:Name="PlaylistDescription" TextWrapping="Wrap" MaxLines="3" MaxHeight="160" IsTextSelectionEnabled="True"/><Button x:Name="ExpandDescriptionButton" Content="展开简介" Click="ExpandDescription_Click" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="28" HorizontalAlignment="Left"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Spacing="14"><Button Content="播放全部" Style="{StaticResource AccentButtonStyle}" Click="PlayAll_Click"/><Button x:Name="PlaylistSubscribeButton" Content="收藏" Click="PlaylistSubscribe_Click" Visibility="Collapsed"/><Button x:Name="PlaylistCommentsButton" Content="评论" Click="PlaylistComments_Click" Visibility="Collapsed"/><TextBlock x:Name="TrackCount" VerticalAlignment="Center" Opacity=".6"/></StackPanel></StackPanel><ListView x:Name="TrackList" Grid.Row="1" ItemsSource="{x:Bind Tracks}" IsItemClickEnabled="True" ItemClick="Track_Click" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate x:DataType="models:Track"><Grid MinHeight="76" Padding="4,6" ColumnSpacing="14"><Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="播放" Click="ContextPlay_Click"/><MenuFlyoutItem Text="歌手" Click="ContextArtist_Click"/><MenuFlyoutItem Text="专辑" Click="ContextAlbum_Click"/><MenuFlyoutItem Text="收藏到歌单" Click="ContextFavorite_Click"/><MenuFlyoutItem Text="下载" Click="ContextDownload_Click"/></MenuFlyout></Grid.ContextFlyout><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions><Border CornerRadius="6" Width="56" Height="56" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="20" Opacity=".2"/><Image services:Artwork.Uri="{Binding Cover, Mode=OneTime}" services:Artwork.Size="56" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{Binding Title, Mode=OneTime}" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle, Mode=OneTime}" Opacity=".6" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneTime}" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity=".55"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><Button Grid.Row="2" x:Name="LoadMoreButton" Content="加载更多" HorizontalAlignment="Center" Margin="0,8" Click="LoadMore_Click" Visibility="Collapsed"/></Grid>
     <Grid x:Name="SocialPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ComboBox x:Name="MessageCategory" Visibility="Collapsed" SelectionChanged="MessageCategory_Changed" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="通知" Tag="notices"/><ComboBoxItem Content="回复我的评论" Tag="comments"/><ComboBoxItem Content="@我" Tag="mentions"/></ComboBox>
      <ListView x:Name="SocialList" Grid.Row="1" ItemsSource="{x:Bind SocialItems}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Social_Click" HorizontalContentAlignment="Stretch">
       <ListView.ItemTemplate><DataTemplate x:DataType="models:SocialItem"><Grid Margin="4,10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"><Image services:Artwork.Uri="{Binding Avatar}" services:Artwork.Size="40" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Action}" FontSize="12" Opacity=".6" Visibility="{Binding ActionVisibility}"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><Border Padding="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Visibility="{Binding OriginalVisibility}"><TextBlock Text="{Binding OriginalText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity=".7"/></Border><Image services:Artwork.Uri="{Binding Picture}" services:Artwork.Size="420" MaxHeight="300" MaxWidth="420" HorizontalAlignment="Left" Stretch="Uniform"/><TextBlock Text="{Binding Time}" FontSize="12" Opacity=".55"/><StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding ActionsVisibility}"><Button Content="{Binding LikeLabel}" Click="SocialLike_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0"/><Button Content="{Binding CommentLabel}" Click="SocialComment_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0"/></StackPanel></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <Button Grid.Row="2" x:Name="SocialMore" Content="加载更多" Click="LoadMore_Click" HorizontalAlignment="Center" Margin="0,8"/>
      <Grid x:Name="PrivateComposer" Grid.Row="3" Visibility="Collapsed" ColumnSpacing="10" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PrivateText" PlaceholderText="消息" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MaxLength="2000"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"><Button Click="SharePrivate_Click" ToolTipService.ToolTip="分享歌曲、专辑或歌单" AutomationProperties.Name="分享"><FontIcon Glyph="&#xE72D;"/></Button><Button x:Name="SendPrivateButton" Content="发送" Click="SendPrivate_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Grid>
     </Grid>
     <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,0,12,16">
      <Border Style="{StaticResource SettingsCard}"><ToggleSwitch x:Name="TrayToggle" Header="关闭时最小化到托盘" Toggled="Setting_Changed"/></Border>
      <Border Style="{StaticResource SettingsCard}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="材质" VerticalAlignment="Center"/><ComboBox x:Name="BackdropCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Setting_Changed"><ComboBoxItem Content="Mica" Tag="Mica"/><ComboBoxItem Content="Mica Alt" Tag="MicaAlt"/><ComboBoxItem Content="Acrylic" Tag="Acrylic"/><ComboBoxItem Content="纯色" Tag="Solid"/></ComboBox></Grid></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel><Grid><TextBlock Text="透明度"/><TextBlock x:Name="TransparencyValue" HorizontalAlignment="Right"/></Grid><Slider x:Name="TransparencySlider" Maximum="100" ValueChanged="Transparency_Changed" AutomationProperties.Name="材质透明度"/><TextBlock x:Name="MaterialHint" TextWrapping="Wrap" FontSize="12" Opacity=".6"/></StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="主题" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Setting_Changed"><ComboBoxItem Content="跟随系统" Tag="Default"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox></Grid></Border>
      <Border Style="{StaticResource SettingsCard}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="字体" VerticalAlignment="Center"/><ComboBox x:Name="FontCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Font_Changed" IsTextSearchEnabled="True"/></Grid></Border>
      <Border Style="{StaticResource SettingsCard}"><ToggleSwitch x:Name="AnimationToggle" Header="动画" Toggled="Setting_Changed"/></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel Spacing="10"><TextBlock Text="缓存目录"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CachePath" IsReadOnly="True"/><Button Grid.Column="1" Content="选择" Tag="cache" Click="ChooseFolder_Click"/></Grid></StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel Spacing="10"><TextBlock Text="下载目录"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DownloadPath" IsReadOnly="True"/><Button Grid.Column="1" Content="选择" Tag="download" Click="ChooseFolder_Click"/></Grid></StackPanel></Border>
      <TextBlock Text="NetEaseNEXT 0.2" Opacity=".55" Margin="0,12"/>
     </StackPanel></ScrollViewer>
     <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360"><TextBlock x:Name="EmptyText" Text="暂无内容" TextWrapping="Wrap" HorizontalTextAlignment="Center" Opacity=".6"/><Button x:Name="EmptyAction" Content="重试" Click="EmptyAction_Click" HorizontalAlignment="Center"/></StackPanel>
     <ProgressRing x:Name="Busy" IsHitTestVisible="False" IsActive="False" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
   </Grid>
  </NavigationView>
  <Grid x:Name="PlayingPanel" Grid.Row="1" Visibility="Collapsed">
   <Image x:Name="BlurredCover" Stretch="UniformToFill" Opacity=".25" IsHitTestVisible="False"/>
   <Border x:Name="CoverTint" Opacity=".8" IsHitTestVisible="False"/>
   <Grid x:Name="PlayerLayout" ColumnSpacing="64" Padding="64,24,64,32">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="CoverColumn" VerticalAlignment="Center" Spacing="12" MaxWidth="500">
     <TextBlock x:Name="NowTitle" Text="未播放" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
     <Button Click="CurrentArtist_Click" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="24" HorizontalAlignment="Center"><TextBlock x:Name="NowArtist" Opacity=".65" TextTrimming="CharacterEllipsis"/></Button>
     <Border x:Name="CoverFrame" CornerRadius="12" HorizontalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Image x:Name="LargeCover" Stretch="UniformToFill" services:Artwork.Size="560"/></Border>
     <Grid x:Name="PageTransportHost" Margin="0,4,0,0"/>
     <Grid x:Name="PageSongActionsHost" HorizontalAlignment="Center"/>
     <Grid x:Name="PageToolsHost" HorizontalAlignment="Center"/>
    </StackPanel>
    <Grid Grid.Column="1"><ListView x:Name="LyricsList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Lyric_Click" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="10,16" Spacing="8"><TextBlock Text="{Binding Text}" FontSize="25" TextWrapping="Wrap"/><TextBlock Text="{Binding Translation}" FontSize="18" Opacity=".65" TextWrapping="Wrap" Visibility="{Binding TranslationVisibility}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><Button x:Name="FollowLyricsButton" Content="回到当前歌词" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="FollowLyrics_Click" Visibility="Collapsed"/></Grid>
   </Grid>
  </Grid>
  <Border x:Name="PlayerFooter" Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8,16,12">
   <Grid x:Name="FooterLayout" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Click="ShowPlaying_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" AutomationProperties.Name="打开播放器"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="54" Height="54" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid><FontIcon Glyph="&#xE8D6;" Opacity=".2"/><Image x:Name="MiniCover" Stretch="UniformToFill" services:Artwork.Size="54"/></Grid></Border><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock x:Name="MiniTitle" Text="未播放" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MiniArtist" FontSize="12" Opacity=".6" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Button><Grid x:Name="FooterSongActionsHost" Grid.Column="1" VerticalAlignment="Center"><StackPanel x:Name="SongActions" Orientation="Horizontal"><Button x:Name="HeartButton" Click="Heart_Click" IsEnabled="False" Background="Transparent" BorderThickness="0" AutomationProperties.Name="红心"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon x:Name="HeartIcon" Glyph="&#xEB51;" FontSize="18"/><TextBlock x:Name="RedCountText" Text="—" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="SongCommentsButton" Click="SongComments_Click" IsEnabled="False" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="歌曲评论" AutomationProperties.Name="歌曲评论"><FontIcon Glyph="&#xE90A;" FontSize="18"/></Button></StackPanel></Grid></Grid>
    <Grid x:Name="FooterTransportHost" Grid.Column="1">
     <Grid x:Name="TransportControls"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="TransportButtons" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
       <Button x:Name="ModeButton" Click="Mode_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="顺序播放" AutomationProperties.Name="播放顺序"><FontIcon x:Name="ModeIcon" Glyph="&#xE8EE;" FontSize="16"/></Button>
       <Button Click="Previous_Click" Background="Transparent" BorderThickness="0" AutomationProperties.Name="上一首"><FontIcon Glyph="&#xE892;" FontSize="18"/></Button>
       <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Style="{StaticResource AccentButtonStyle}" Width="48" Height="44" AutomationProperties.Name="播放或暂停"><FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="19"/></Button>
       <Button Click="Next_Click" Background="Transparent" BorderThickness="0" AutomationProperties.Name="下一首"><FontIcon Glyph="&#xE893;" FontSize="18"/></Button>
       <Button x:Name="QueueButton" Click="ShowQueue_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="播放列表" AutomationProperties.Name="播放列表"><FontIcon Glyph="&#xE8FD;" FontSize="16"/></Button>
      </StackPanel>
      <Grid x:Name="ProgressControls" Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Text="0:00" FontSize="11" Opacity=".55" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Grid.Column="1" Maximum="1" ValueChanged="Seek_Changed" AutomationProperties.Name="播放进度"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="11" Opacity=".55" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
     </Grid>
    </Grid>
    <Grid x:Name="FooterToolsHost" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
     <StackPanel x:Name="PlayerTools" Orientation="Horizontal" Spacing="0">
      <Button Click="FavoriteCurrent_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="收藏到歌单" AutomationProperties.Name="收藏到歌单"><FontIcon Glyph="&#xE8F4;" FontSize="18"/></Button>
      <Button x:Name="QualityButton" Content="音质" Click="Quality_Click" Padding="8,0" Background="Transparent" BorderThickness="0"/>
      <Button x:Name="SoundButton" Click="Sound_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="音量和音效" AutomationProperties.Name="音量和音效"><FontIcon Glyph="&#xE767;" FontSize="18"/></Button>
      <Button Click="DownloadCurrent_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="下载" AutomationProperties.Name="下载"><FontIcon Glyph="&#xE896;" FontSize="18"/></Button>
      <Button x:Name="FullScreenButton" Click="FullScreen_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="全屏" AutomationProperties.Name="全屏"><FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="18"/></Button>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
  <Border x:Name="QueuePane" Grid.Row="1" Width="400" MaxHeight="520" Margin="16" Padding="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="10" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="播放列表" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Click="ShowQueue_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" AutomationProperties.Name="收起播放列表"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button></Grid><ListView x:Name="QueueList" Grid.Row="1" MaxHeight="440" IsItemClickEnabled="True" ItemClick="QueueTrack_Click" SelectionMode="Single" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="models:Track"><Grid ColumnSpacing="12" Padding="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="5"><Image services:Artwork.Uri="{Binding Cover}" services:Artwork.Size="44" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity=".6" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>
  </Border>
  <InfoBar x:Name="PlayerNotice" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24" IsOpen="False" IsClosable="True" MaxWidth="620"/>
 </Grid></ContentControl>
</Window>
