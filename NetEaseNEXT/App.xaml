<Application x:Class="NetEaseNEXT.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
      <Color x:Key="SystemAccentColor">#E84C63</Color>
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D93853"/>
      <Style TargetType="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="CornerRadius" Value="10"/></Style>
      <Style TargetType="ToggleSwitch"><Setter Property="MinHeight" Value="48"/></Style>
      <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
