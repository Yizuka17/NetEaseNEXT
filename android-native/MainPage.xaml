<Page x:Class="NetEaseNEXTMobile.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <ScrollViewer>
  <StackPanel Padding="20" Spacing="12">
   <TextBlock Text="NetEaseNEXT" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="Android · 纯 C# API 验证版" FontSize="12" Opacity=".65"/>
   <StackPanel x:Name="LoginPanel" Spacing="12">
    <TextBlock Text="登录网易云音乐" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="请使用另一台设备的网易云音乐客户端扫码确认。" TextWrapping="Wrap"/>
    <Button x:Name="LoginButton" Content="获取二维码" Click="Login_Click" HorizontalAlignment="Stretch"/>
    <Image x:Name="QrImage" Width="224" Height="224" Visibility="Collapsed"/>
    <TextBlock x:Name="LoginStatusText" Text="无需电脑，手机直接连接网易云接口。" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel x:Name="LibraryPanel" Spacing="10" Visibility="Collapsed">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="AccountText" FontSize="18" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Content="退出登录" Click="Logout_Click"/>
    </Grid>
    <TextBlock Text="我的歌单" FontSize="19" FontWeight="SemiBold"/>
    <ListView x:Name="PlaylistList" Height="170" DisplayMemberPath="Name" SelectionMode="Single" SelectionChanged="Playlist_Changed"/>
    <TextBlock Text="歌曲" FontSize="19" FontWeight="SemiBold"/>
    <ListView x:Name="TrackList" Height="240" SelectionMode="Single" SelectionChanged="Track_Changed">
     <ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,5" Spacing="3">
      <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity=".65" TextTrimming="CharacterEllipsis"/>
     </StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </StackPanel>
   <StackPanel x:Name="PlayerPanel" Spacing="10" Visibility="Collapsed">
    <Image x:Name="CoverImage" Height="200" Width="200" HorizontalAlignment="Center" Stretch="UniformToFill"/>
    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
    <TextBlock x:Name="ArtistText" Opacity=".7" TextWrapping="Wrap" HorizontalAlignment="Center"/>
    <Slider x:Name="PositionSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="Position_Changed"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PositionText" Text="0:00" FontSize="12"/>
     <TextBlock x:Name="DurationText" Grid.Column="1" Text="0:00" FontSize="12"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
     <Button Content="播放 / 暂停" Click="Toggle_Click"/>
     <Button Content="停止" Click="Stop_Click"/>
    </StackPanel>
   </StackPanel>
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity=".7"/>
  </StackPanel>
 </ScrollViewer>
</Page>
