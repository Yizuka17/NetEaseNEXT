<Page x:Class="NetEaseNEXTMobile.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid x:Name="Shell" utu:SafeArea.Insets="Left,Top,Right,Bottom">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact Fluent header, always below the Android status bar. -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid Padding="20,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="11"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE8D6;" FontSize="19"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="NetEaseNEXT" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="音乐库" FontSize="12" Opacity="0.6"/>
                </StackPanel>
                <Button x:Name="LogoutButton" Grid.Column="2"
                        Content="退出" Visibility="Collapsed"
                        Click="Logout_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="LoginPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="22,26" Spacing="16">
                <TextBlock Text="欢迎回来" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="登录后即可访问自己的歌单与在线音乐。" TextWrapping="Wrap" Opacity="0.7"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="18">
                    <StackPanel Spacing="16">
                        <TextBlock Text="网易云音乐扫码登录" FontSize="17" FontWeight="SemiBold"/>
                        <Border Background="White" CornerRadius="10" Padding="10"
                                Width="248" Height="248" HorizontalAlignment="Center">
                            <Grid>
                                <SymbolIcon Symbol="Contact" Width="42" Height="42"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="QrImage" Width="224" Height="224"
                                       Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Button x:Name="LoginButton" Content="获取二维码" Click="Login_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="LoginStatusText"
                                   Text="使用另一台设备的网易云音乐客户端扫码确认。"
                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.68"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- One scrolling song list. No nested ScrollViewers or fixed list heights. -->
        <Grid x:Name="LibraryPanel" Grid.Row="1" Visibility="Collapsed" Padding="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <PersonPicture x:Name="AccountAvatar" Width="40" Height="40"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="AccountText" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="已连接网易云音乐" FontSize="12" Opacity="0.58"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="9" Margin="0,20,0,12">
                <TextBlock Text="我的歌单" FontSize="21" FontWeight="SemiBold"/>
                <ComboBox x:Name="PlaylistList" HorizontalAlignment="Stretch"
                          DisplayMemberPath="Name" PlaceholderText="选择歌单"
                          SelectionChanged="Playlist_Changed"/>
                <TextBlock Text="歌曲" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </StackPanel>
            <ListView Grid.Row="2" x:Name="TrackList"
                      SelectionMode="Single" SelectionChanged="Track_Changed"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4,7" MinHeight="62">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="9"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE8D6;" Opacity="0.55" FontSize="18"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding Title}" FontSize="14.5"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Docked now-playing card; never pushes the song list offscreen. -->
        <Border x:Name="PlayerPanel" Grid.Row="2" Visibility="Collapsed"
                Margin="12,8,12,0" Padding="12" CornerRadius="15"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="9" Height="54" Width="54">
                        <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" FontSize="12" Opacity="0.62"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="ToggleButton" Grid.Column="2"
                            Content="暂停" Click="Toggle_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center" MinWidth="60"/>
                    <Button Grid.Column="3" Content="停止" Click="Stop_Click"
                            VerticalAlignment="Center" MinWidth="52"/>
                </Grid>
                <Slider x:Name="PositionSlider" Minimum="0" Maximum="100"
                        ValueChanged="Position_Changed"/>
                <Grid Margin="4,-8,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" FontSize="11" Opacity="0.6" Text="0:00"/>
                    <TextBlock x:Name="DurationText" Grid.Column="1"
                               FontSize="11" Opacity="0.6" Text="0:00"/>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="3"
                   Margin="20,5,20,8" FontSize="12" Opacity="0.65"
                   TextTrimming="CharacterEllipsis" MaxLines="2"
                   TextWrapping="Wrap"/>
    </Grid>
</Page>