<Page
    x:Class="NetEaseNEXTMobile.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="NetEaseNEXT" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Android 播放器验证版" Opacity="0.65" FontSize="13"/>
            <TextBox x:Name="SongIdBox" Header="网易云歌曲 ID" PlaceholderText="例如歌曲分享链接中的 id" InputScope="Number"/>
            <Button x:Name="LoadButton" Content="加载并播放" HorizontalAlignment="Stretch" Click="Load_Click"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" HorizontalAlignment="Center">
                <Image x:Name="CoverImage" Width="200" Height="200" Stretch="UniformToFill"/>
            </Border>
            <TextBlock x:Name="TitleText" Text="尚未加载歌曲" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ArtistText" Text="" TextWrapping="Wrap" Opacity="0.7" HorizontalAlignment="Center"/>
            <Slider x:Name="PositionSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="Position_Changed"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" Text="0:00" FontSize="12" Opacity="0.7"/>
                <TextBlock x:Name="DurationText" Grid.Column="1" Text="0:00" FontSize="12" Opacity="0.7"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button x:Name="ToggleButton" Content="播放 / 暂停" Click="Toggle_Click" IsEnabled="False"/>
                <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="连接电脑端 API 后，输入歌曲 ID 开始播放。" TextWrapping="Wrap" Opacity="0.75"/>
        </StackPanel>
    </ScrollViewer>
</Page>
